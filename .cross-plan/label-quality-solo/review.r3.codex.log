"""Build a separate reviewed-label candidate and stage a 224 protocol pair."""
import ast
import hashlib
import inspect
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
import pandas as pd
from src.labels.reviewed import apply_reviewed
from tools.prepare_kaggle_training_pair import training_source

# Exact excerpts checked against full reports. Unsupported/ambiguous positives
# are deliberately absent: absence of report evidence alone is not a negative.
EVIDENCE = {
    'R049': '<redacted report excerpt>',
    'R058': '<redacted report excerpt>',
    'R088': '<redacted report excerpt>',
    'R125': '<redacted report excerpt>',
    'R127': '<redacted report excerpt>',
    'R149': '<redacted report excerpt>',
    'R150': '<redacted report excerpt>',
    'R163': '<redacted report excerpt>',
    'R168': '<redacted report excerpt>',
    'R193': '<redacted report excerpt>',
    'R195': '<redacted report excerpt>'
}


def stage_source(notebook, label_hash, corrections, arm, fold=1):
    source = training_source(notebook, 'baseline', label_hash, fold=fold, match_slice=True)
    source = source.replace(f'/kaggle/working/baseline_fold{fold}',
                            f'/kaggle/working/reviewed_{arm}_fold{fold}')
    tree = ast.parse(source)
    changed = 0
    correction_hash = hashlib.sha256(json.dumps(corrections, sort_keys=True).encode()).hexdigest()
    for pos in range(len(tree.body)-1, -1, -1):
        node = tree.body[pos]
        if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'index' for t in node.targets):
            hook = f'''import hashlib
import json
import numpy as np
{inspect.getsource(apply_reviewed)}
_review_corrections = {corrections!r}
_fixed_split = folded[["StudyInstanceUID", "fold"]].copy()
_unchanged_validation = folded.loc[folded.fold == {fold}].copy(deep=True)
if {arm == 'candidate'!r}:
    folded = apply_reviewed(folded, _fixed_split, _review_corrections, {fold})
pd.testing.assert_frame_equal(_fixed_split, folded[["StudyInstanceUID", "fold"]])
pd.testing.assert_frame_equal(_unchanged_validation, folded.loc[folded.fold == {fold}])
pathlib.Path("label_review_contract.json").write_text(json.dumps({{"arm": {arm!r}, "corrections_sha256": {correction_hash!r}, "original_labels_sha256": {label_hash!r}, "correction_count": {len(corrections) if arm == 'candidate' else 0}, "validation_labels_changed": False, "folds_changed": False}}, indent=2))
'''
            tree.body[pos:pos] = ast.parse(hook).body
            changed += 1
    if changed != 1:
        raise ValueError('StudyIndex construction changed; no safe insertion point')
    return ast.unparse(ast.fix_missing_locations(tree)) + '\n'


def build():
    root = ROOT / 'outputs/reviewed_labels_v1'
    root.mkdir(parents=True, exist_ok=True)
    queue = [json.loads(line) for line in (ROOT / 'outputs/label_review_v1/review_queue.jsonl').read_text().splitlines()]
    labels_path = ROOT / 'data/meta/train_labels.parquet'
    labels = pd.read_parquet(labels_path)
    folded = pd.read_parquet(ROOT / 'outputs/ensemble_16_24/reconstructed_folds.parquet')
    reports = pd.read_csv(ROOT / 'data/meta/train.csv').set_index('StudyInstanceUID')
    corrections = []
    for row in queue:
        if row['review_id'] not in EVIDENCE:
            continue
        evidence = EVIDENCE[row['review_id']]
        text = str(reports.at[row['StudyInstanceUID'], 'Report'])
        if evidence not in text or text != row['report']:
            raise ValueError('Review source changed')
        corrections.append({'review_id': row['review_id'], 'StudyInstanceUID': row['StudyInstanceUID'],
            'finding': row['finding'], 'old_target': row['target'], 'new_target': 0.,
            'evidence': evidence, 'rationale': row['review_note'],
            'report_sha256': hashlib.sha256(text.encode()).hexdigest()})
    if len(corrections) != len(EVIDENCE):
        raise ValueError('Missing reviewed correction')
    candidate = apply_reviewed(labels, folded, corrections, 1, reports)
    candidate.to_parquet(root / 'train_labels_reviewed_v1.parquet', index=False)
    (root / 'corrections.json').write_text(json.dumps(corrections, ensure_ascii=False, indent=2)+'\n')
    notebook = json.loads((ROOT / 'notebooks/08_finetune.ipynb').read_text())
    label_hash = hashlib.sha256(labels_path.read_bytes()).hexdigest()
    for arm in ('control', 'candidate'):
        source = stage_source(notebook, label_hash, corrections, arm)
        compile(source, arm, 'exec')
        (root / f'{arm}_fold1.py').write_text(source)
    receipt = {'state': 'staged_not_trained', 'corrections': len(corrections),
        'original_labels_sha256': label_hash,
        'candidate_labels_sha256': hashlib.sha256((root/'train_labels_reviewed_v1.parquet').read_bytes()).hexdigest(),
        'reserved_folds': [1,3], 'recipe': '224px protocol ConvNeXt V1, 16 slices, five series, 12 epochs, effective batch eight',
        'scope': 'Eleven report-grounded corrections, not a corpus-wide automatic relabeler. Original weights and validation labels retained. Fixed original split computed before changes.'}
    (root / 'receipt.json').write_text(json.dumps(receipt, indent=2)+'\n')
    print(json.dumps(receipt, indent=2))


if __name__ == '__main__':
    build()
"""Cross-validation splits and the gold holdout.

Two rules govern every split here, and both exist because the obvious
alternative produces a number that looks better and means less.

**Split by study, never by series.** A study's ~5.5 series image the same knee
in the same session. A random series split puts near-duplicates on both sides
and reports an accuracy the model does not have.

**The 58 gold studies never enter training.** They are the only radiologist
labels in the dataset and the only honest measurement available. Everything
else is trained on mined labels, and a model evaluated against mined labels can
score well by reproducing the extractor's mistakes. `assert_no_gold_leakage`
is called by the training entrypoint rather than trusted to discipline.
"""

from typing import Iterator, List, Optional, Sequence, Tuple

import numpy as np
import pandas as pd

from src import config

N_FOLDS = 5
SEED = 0


def load_gold_uids(train_csv=None) -> set:
    """Study UIDs of the 58 radiologist-labelled studies."""
    frame = pd.read_csv(train_csv or config.TRAIN_CSV)
    labelled = frame[frame[config.LABELS[0]].notna()]
    return set(labelled[config.ID_COL])


def assert_no_gold_leakage(train_uids: Sequence[str], gold_uids: set) -> None:
    """Fail loudly if a gold study appears in training data.

    Called from the training entrypoint. The failure this guards against is
    silent -- a leaked gold study inflates the one number being used to decide
    whether the model works.
    """
    leaked = set(train_uids) & gold_uids
    if leaked:
        raise ValueError(
            f"{len(leaked)} gold studies leaked into training: "
            f"{sorted(leaked)[:3]}..."
        )


def stratification_key(labels: pd.DataFrame) -> pd.Series:
    """A coarse key for balancing folds across a 12-label problem.

    Full multi-label stratification over 2^12 combinations would leave most
    cells empty at 4,349 studies. The count of positive findings captures the
    axis that matters -- studies with many findings are rare and should not
    cluster in one fold.
    """
    positives = (labels[config.LABELS] > 0.5).sum(axis=1)
    return positives.clip(upper=4)


def scanner_key(index: pd.DataFrame) -> pd.Series:
    """A per-study scanner identity, from the header scan's index.

    The dataset spans 16-19 sites on five continents, and a CNN reads scanner
    signature as readily as it reads pathology. A fold split that puts the same
    scanner on both sides therefore reports an accuracy that does not survive
    a new site: the plan's figure is ~0.053 of inflation from random K-fold,
    with one measured model showing a 0.136 grouped-vs-random gap.

    Site is not given, so manufacturer + model + field strength stands in for
    it. That is coarser than a site id -- two hospitals with the same scanner
    collapse into one group, which makes the split *more* conservative, not
    less -- and it is what the DICOM headers actually carry.

    Takes the frame `src/data/index.py` writes (one row per instance or
    series, carrying `StudyInstanceUID`), and returns one key per study,
    indexed by study UID. A study whose headers name none of the three fields
    gets "unknown", and those all land in one group together.
    """
    fields = [c for c in ("Manufacturer", "ManufacturerModelName",
                          "MagneticFieldStrength") if c in index.columns]
    if not fields:
        raise ValueError(
            "the index carries none of Manufacturer / ManufacturerModelName / "
            f"MagneticFieldStrength; it has {list(index.columns)[:8]}")

    # fillna after astype: pandas keeps a missing value missing through
    # astype(str) rather than rendering it "nan", and the join below would
    # then fail on a float instead of producing a key.
    joined = index[fields].astype(str).fillna("nan").agg("|".join, axis=1)
    joined = joined.where(~joined.str.fullmatch(r"(nan\|?)+"), "unknown")
    # The first series scanned decides the study. A study imaged on two
    # scanners is rare and either group is defensible; taking the first keeps
    # the assignment deterministic.
    return joined.groupby(index[config.ID_COL]).first()


def make_folds(labels: pd.DataFrame, n_folds: int = N_FOLDS,
               seed: int = SEED,
               groups: Optional[pd.Series] = None) -> pd.DataFrame:
    """Assign each study to a fold, stratified by positive-finding count.

    Returns the frame with a `fold` column added.

    `groups` maps study UID -> group id (see `scanner_key`). When given, a
    whole group lands in one fold: the split becomes leave-scanner-out rather
    than leave-study-out, so validation measures transfer to unseen equipment
    instead of rewarding memorised scanner signature.

    Grouping costs balance. Groups are sized very unequally -- one scanner may
    hold a quarter of the corpus -- so groups are assigned largest-first to
    whichever fold is currently smallest, which is the standard greedy
    approximation and the best available without splitting a group. Check
    `summarise()` afterwards: badly imbalanced folds are the price of grouping,
    and worth knowing before a run rather than after.

    **Changing this re-cuts every fold**, and every reference number on record
    (fold 1: val 0.872 / gold 0.861 / LB 0.889) belongs to the ungrouped
    split. Adopt it when the fold ensemble is rebuilt, not in the middle of an
    experiment that is being compared against those numbers.
    """
    frame = labels.copy().reset_index(drop=True)
    key = stratification_key(frame)
    rng = np.random.default_rng(seed)

    frame["fold"] = -1
    if groups is None:
        for value in key.unique():
            rows = np.flatnonzero(key.to_numpy() == value)
            rng.shuffle(rows)
            frame.loc[rows, "fold"] = np.arange(len(rows)) % n_folds
    else:
        mapped = frame[config.ID_COL].map(groups).fillna("unknown")
        sizes = mapped.value_counts()
        # Shuffle before sorting so equal-sized groups do not always fall the
        # same way, then place the largest first into the emptiest fold.
        order = sizes.sample(frac=1.0, random_state=seed).sort_values(
            ascending=False, kind="mergesort").index
        counts = np.zeros(n_folds, dtype=int)
        for group in order:
            fold = int(np.argmin(counts))
            rows = np.flatnonzero(mapped.to_numpy() == group)
            frame.loc[rows, "fold"] = fold
            counts[fold] += len(rows)

    if (frame["fold"] < 0).any():
        raise RuntimeError("some studies were not assigned a fold")
    return frame


def iter_folds(labels: pd.DataFrame,
               n_folds: int = N_FOLDS) -> Iterator[Tuple[pd.DataFrame, pd.DataFrame]]:
    """Yield (train, validation) frames for each fold."""
    if "fold" not in labels.columns:
        labels = make_folds(labels, n_folds=n_folds)

    for fold in range(n_folds):
        validation = labels[labels["fold"] == fold]
        train = labels[labels["fold"] != fold]
        yield train.reset_index(drop=True), validation.reset_index(drop=True)


def series_for_studies(manifest: pd.DataFrame,
                       study_uids: Sequence[str]) -> pd.DataFrame:
    """All cached series belonging to a set of studies."""
    wanted = set(study_uids)
    return manifest[manifest[config.ID_COL].isin(wanted)].reset_index(drop=True)


def summarise(labels: pd.DataFrame, n_folds: int = N_FOLDS) -> pd.DataFrame:
    """Per-fold positive rates, to confirm the folds are actually comparable."""
    if "fold" not in labels.columns:
        labels = make_folds(labels, n_folds=n_folds)

    rows = []
    for fold in range(n_folds):
        subset = labels[labels["fold"] == fold]
        row = {"fold": fold, "studies": len(subset)}
        for name in config.LABELS:
            row[name] = float((subset[name] > 0.5).mean())
        rows.append(row)
    return pd.DataFrame(rows).set_index("fold")
import copy
import hashlib
import json
from pathlib import Path
import ast
import pathlib

import pandas as pd
import pytest

from src.labels.reviewed import apply_reviewed
from tools.prepare_reviewed_labels import stage_source


def inputs():
    labels = pd.DataFrame({'StudyInstanceUID': ['development', 'val1', 'val3'],
                           'ACL': [.9, .7, .2], 'ACL_weight': [1., .7, .4]})
    folds = pd.DataFrame({'StudyInstanceUID': ['development', 'val1', 'val3'], 'fold': [0,1,3]})
    reports = pd.DataFrame({'Report': ['ACL intact.']}, index=['development'])
    corrections = [{'StudyInstanceUID': 'development', 'finding': 'ACL',
        'old_target': .9, 'new_target': 0., 'evidence': 'ACL intact.',
        'report_sha256': hashlib.sha256(b'ACL intact.').hexdigest()}]
    return labels, folds, corrections, reports


@pytest.mark.parametrize('fold', [1,3])
def test_training_only_with_immutable_inputs(fold):
    labels, folds, corrections, reports = inputs()
    before = labels.copy(deep=True)
    result = apply_reviewed(labels, folds, corrections, fold, reports)
    pd.testing.assert_frame_equal(labels, before)
    assert result.loc[0, 'ACL'] == 0
    pd.testing.assert_frame_equal(result.iloc[1:], before.iloc[1:])
    pd.testing.assert_series_equal(result.ACL_weight, before.ACL_weight)


@pytest.mark.parametrize('mutation', ['heldout', 'old_target', 'quote', 'duplicate'])
def test_rejects_unreviewed_or_leaking_changes(mutation):
    labels, folds, corrections, reports = inputs()
    if mutation == 'heldout':
        corrections[0]['StudyInstanceUID'] = 'val3'
    elif mutation == 'old_target':
        corrections[0]['old_target'] = .8
    elif mutation == 'quote':
        corrections[0]['evidence'] = 'ACL torn.'
    else:
        corrections.append(copy.deepcopy(corrections[0]))
    with pytest.raises(ValueError):
        apply_reviewed(labels, folds, corrections, 1, reports)


def test_actual_candidate_has_exactly_reviewed_changes():
    root = Path(__file__).resolve().parents[1]
    labels = pd.read_parquet(root/'data/meta/train_labels.parquet')
    candidate = pd.read_parquet(root/'outputs/reviewed_labels_v1/train_labels_reviewed_v1.parquet')
    corrections = json.loads((root/'outputs/reviewed_labels_v1/corrections.json').read_text())
    folded = pd.read_parquet(root/'outputs/ensemble_16_24/reconstructed_folds.parquet')
    reports = pd.read_csv(root/'data/meta/train.csv').set_index('StudyInstanceUID')
    expected = apply_reviewed(labels, folded, corrections, 1, reports)
    pd.testing.assert_frame_equal(candidate, expected)
    assert (labels != candidate).to_numpy().sum() == len(corrections) == 11
    assert labels.StudyInstanceUID.equals(candidate.StudyInstanceUID)


def test_staged_review_hook_executes_before_the_notebooks_later_imports(tmp_path, monkeypatch):
    """Exercise the exact injected preflight, not merely compilation."""
    root = Path(__file__).resolve().parents[1]
    notebook = json.loads((root / 'notebooks/08_finetune.ipynb').read_text())
    corrections = json.loads((root / 'outputs/reviewed_labels_v1/corrections.json').read_text())
    label_hash = hashlib.sha256((root / 'data/meta/train_labels.parquet').read_bytes()).hexdigest()
    labels = pd.read_parquet(root / 'data/meta/train_labels.parquet')
    split = pd.read_parquet(root / 'outputs/ensemble_16_24/reconstructed_folds.parquet')
    folded = labels.merge(split, on='StudyInstanceUID', validate='one_to_one')
    monkeypatch.chdir(tmp_path)

    for arm in ('control', 'candidate'):
        source = stage_source(notebook, label_hash, corrections, arm, fold=1)
        tree = ast.parse(source)
        start = next(i for i, node in enumerate(tree.body)
                     if isinstance(node, ast.Import)
                     and [alias.name for alias in node.names] == ['hashlib']
                     and i + 1 < len(tree.body)
                     and isinstance(tree.body[i + 1], ast.Import)
                     and [alias.name for alias in tree.body[i + 1].names] == ['json'])
        end = next(i for i, node in enumerate(tree.body[start:], start)
                   if any(isinstance(item, ast.Constant) and item.value == 'label_review_contract.json'
                          for item in ast.walk(node)))
        namespace = {'folded': folded.copy(deep=True), 'pd': pd, 'pathlib': pathlib}
        exec(compile(ast.fix_missing_locations(ast.Module(tree.body[start:end + 1], [])),
                     f'{arm}_preflight.py', 'exec'), namespace)
        contract = json.loads((tmp_path / 'label_review_contract.json').read_text())
        assert contract['arm'] == arm
        assert contract['validation_labels_changed'] is False
        assert contract['folds_changed'] is False
"""Check isolation and compute guards before spending remote training time."""

import ast
import json
import sys
from pathlib import Path

import pytest

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from tools.prepare_kaggle_training_pair import INPUT_SEARCH, ROOT, training_source
from tools.kaggle_training_pair_body import validate_contracts


@pytest.mark.parametrize("experiment", ["baseline", "protocol", "classwise", "convnextv2"])
@pytest.mark.parametrize("fold", [1, 3])
def test_staged_training_preserves_modules_and_isolates_artifacts(experiment, fold):
    notebook = json.loads((ROOT / "notebooks/08_finetune.ipynb").read_text())
    source = training_source(notebook, experiment, "fixture-label-hash", fold=fold)
    tree = ast.parse(source)
    original = ["".join(c["source"]) for c in notebook["cells"] if c["cell_type"] == "code"]
    def files(tree):
        return next(ast.literal_eval(n.value) for n in tree.body
                    if isinstance(n, ast.Assign) and isinstance(n.targets[0], ast.Name)
                    and n.targets[0].id == "FILES")
    assert files(tree) == files(ast.parse(original[1]))
    paths = [n.value for n in ast.walk(tree) if isinstance(n, ast.Constant)
             and isinstance(n.value, str) and n.value.startswith("/kaggle/working")]
    assert paths and all(p.startswith(f"/kaggle/working/{experiment}_fold{fold}")
                         or p == f"/kaggle/working/baseline_fold{fold}/run_contract.json"
                         for p in paths)
    assignments = [n for n in tree.body if isinstance(n, ast.Assign)
                   and isinstance(n.targets[0], ast.Name) and n.targets[0].id == "FOLD"]
    assert len(assignments) == 1 and ast.literal_eval(assignments[0].value) == fold
    assert source.index("Matched-run preflight passed") < source.index("trainer.fit(")
    assert "fixture-label-hash" in source
    assert "KNEE_EXPERIMENT" in source
    assert "BASELINE_CONDITIONAL" not in source
    assert "oof.to_parquet" in source and "artifacts.write_metadata" in source
    assert "!pip install" not in source
    assert "STRATEGY = 'ddp' if DEVICES > 1 else 'auto'" in source
    assert source.index("if not trainer.is_global_zero:") < source.index("n_tensors = knee_lightning.export_from_checkpoint")


def test_staging_refuses_unreviewed_experiments_or_notebook_structure():
    with pytest.raises(ValueError, match="screening folds"):
        training_source({}, "baseline", "hash", fold=2)
    with pytest.raises(ValueError, match="recovery checkpoint"):
        training_source({}, "baseline", "hash", recovery={"fixture": True}, fold=3)
    with pytest.raises(ValueError, match="authorized"):
        training_source({}, "resample", "hash")
    with pytest.raises(ValueError, match="structure"):
        training_source({"cells": []}, "baseline", "hash")


def test_recovery_cannot_retrain_and_smoke_checks_end_of_fit_exports():
    notebook = json.loads((ROOT / "notebooks/08_finetune.ipynb").read_text())
    recovery = training_source(notebook, "baseline", "label-hash", recovery={
        "checkpoint_sha256": "checkpoint-hash", "contract": {}})
    tree = ast.parse(recovery)
    calls = [ast.unparse(n.func) for n in ast.walk(tree) if isinstance(n, ast.Call)]
    assert "trainer.fit" not in calls
    assert "checkpoint-hash" in recovery and "Recovered baseline settings changed" in recovery
    assert "oof.to_parquet" in recovery
    smoke = training_source(notebook, "protocol", "label-hash", smoke=True)
    ast.parse(smoke)
    assert "limit_train_batches=8" in smoke and "max_epochs=1" in smoke
    assert "DDP_SMOKE_PASSED" in smoke and "oof.to_parquet" not in smoke


def test_classwise_pair_checks_shared_initialization_without_changing_input_selection():
    notebook = json.loads((ROOT / "notebooks/08_finetune.ipynb").read_text())
    for experiment in ("baseline", "classwise"):
        source = training_source(notebook, experiment, "hash", match_classwise=True)
        assert "MATCH_CLASSWISE = True" in source
        assert "shared_initial_weights_sha256" in source
        assert "('protocol' if EXPERIMENT == 'protocol' else 'uniform')" in source
        assert "RUN.classwise_pool == (EXPERIMENT == 'classwise')" in source
        assert "('model.study_pool.', 'model.head.')" in source
    with pytest.raises(ValueError, match="fresh native-DDP baseline"):
        training_source(notebook, "baseline", "hash", recovery={"fixture": True},
                        match_classwise=True)


