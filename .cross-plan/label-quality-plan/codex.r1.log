for _key, _tensor in sorted(module.state_dict().items()):
    _initial.update(_key.encode())
    _initial.update(_tensor.detach().cpu().contiguous().numpy().tobytes())
_contract = {
    "experiment": RUN.to_dict(), "fold": FOLD, "epochs": EPOCHS, "seed": SEED,
    "devices": DEVICES, "effective_batch": EFFECTIVE_STUDIES,
    "steps": TOTAL_STEPS, "lr": LR, "schedule": SCHEDULE,
    "warmup_steps": WARMUP_STEPS, "initial_weights_sha256": _initial.hexdigest(),
    "torch": torch.__version__, "timm": timm.__version__, "lightning": pl.__version__,
}
if MATCH_CLASSWISE or MATCH_BACKBONE or MATCH_SLICE or MATCH_SPATIAL:
    # Hash only unchanged modules; keep the full initial-state hash for provenance.
    _excluded = (("model.spatial_encoder.",) if MATCH_SPATIAL else
                 ("model.slice_encoder.",) if MATCH_SLICE else
                ("model.backbone.",) if MATCH_BACKBONE else
                 ("model.study_pool.", "model.head."))
    _shared = hashlib.sha256()
    for _key, _tensor in sorted(module.state_dict().items()):
        if not _key.startswith(_excluded):
            _shared.update(_key.encode())
            _shared.update(_tensor.detach().cpu().contiguous().numpy().tobytes())
    _contract["shared_initial_weights_sha256"] = _shared.hexdigest()
if MATCH_BACKBONE:
    _contract["aggregation_seed"] = SEED
    _contract["feature_dim"] = FEATURE_DIM
    _contract["input_defaults"] = BACKBONE_DEFAULTS
if "REFERENCE_CONTRACT" in globals():
    _fold_specific = {"fold", "steps", "warmup_steps"}
    assert {k: v for k, v in _contract.items() if k not in _fold_specific} == {k: v for k, v in REFERENCE_CONTRACT.items() if k not in _fold_specific}, "Completion settings or initialization differ from screened protocol"
_baseline_contract = pathlib.Path(BASELINE_CONTRACT_PATH)
if EXPERIMENT != CONTROL_EXPERIMENT and _baseline_contract.exists():
    _control = json.loads(_baseline_contract.read_text())
    _ignored = {"experiment"} | ({"initial_weights_sha256"} if MATCH_CLASSWISE or MATCH_BACKBONE or MATCH_SLICE or MATCH_SPATIAL else set())
    assert {k: v for k, v in _contract.items() if k not in _ignored} == {k: v for k, v in _control.items() if k not in _ignored}, "Candidate settings or shared initialization differ from baseline"
if int(os.environ.get("LOCAL_RANK", "0")) == 0:
    pathlib.Path("run_contract.json").write_text(json.dumps(_contract, indent=2) + "\\n")
print("Matched-run preflight passed", flush=True)
'''


def training_source(notebook, experiment, labels_sha256, recovery=None, smoke=False, fold=1,
                    match_classwise=False, match_backbone=False, complete_protocol=False,
                    match_slice=False, match_spatial=False, training_seed=0, campaign_completion=False):
    if training_seed not in (0, 1):
        raise ValueError("Campaign seeds are 0 (primary) and 1 (repeat)")
    if campaign_completion and (fold not in (0, 2, 4) or experiment not in ("spatial", "baseline")):
        raise ValueError("Campaign completion supports candidate folds 0, 2, 4 only")
    match_spatial = match_spatial or experiment in ("spatial", "spatial_control")
    if match_spatial and (recovery or complete_protocol or match_classwise
                          or match_backbone or match_slice
                          or experiment not in ("spatial_control", "spatial")):
        raise ValueError("Spatial comparison requires fresh 24-slice protocol arms only")
    match_slice = match_slice or experiment == "slice_transformer"
    if match_slice and (recovery or complete_protocol or match_classwise or match_backbone
                        or experiment not in ("baseline", "slice_transformer")):
        raise ValueError("Slice comparison requires fresh baseline/protocol inputs only")
    if complete_protocol:
        if (fold not in (0, 2, 4) or experiment != "protocol" or recovery
                or match_classwise or match_backbone):
            raise ValueError("Completion is only for unchanged protocol folds 0, 2 and 4")
    elif fold not in VALIDATION_COUNTS and not campaign_completion and not (match_slice and fold in ALL_VALIDATION_COUNTS):
        raise ValueError("Only screening folds 1 and 3 are supported")
    if recovery and fold != 1:
        raise ValueError("The saved recovery checkpoint belongs to fold 1")
    if experiment not in EXPERIMENTS:
        raise ValueError(f"Only the authorized experiments {EXPERIMENTS} are supported")
    match_classwise = match_classwise or experiment == "classwise"
    match_backbone = match_backbone or experiment == "convnextv2"
    if match_backbone and (match_classwise or experiment not in ("baseline", "convnextv2")):
        raise ValueError("Backbone comparison cannot include other architecture or selection changes")
    if recovery and match_classwise:
        raise ValueError("Classwise comparison requires a fresh native-DDP baseline")
    if recovery and match_backbone:
        raise ValueError("Backbone comparison requires a fresh baseline with matched aggregation seed")
    control = "spatial_control" if match_spatial else "baseline"
    sources = ["".join(c["source"]) for c in notebook["cells"] if c["cell_type"] == "code"]
    if len(sources) != 10:
        raise ValueError("Notebook 08 structure changed; review the staging adapter")
    if not sources[0].startswith("!pip install -q timm\n"):
        raise ValueError("Notebook setup changed")
    # Kaggle may mount the competition tree either as /input/competitions/*
    # or directly as /input/rsna-knee-abnormality-detection. The notebook's
    # historical finder skips only the former; patch the embedded run source
    # so it never recursively walks the raw-DICOM tree while locating caches.
    for i, source in enumerate(sources):
        sources[i] = source.replace(
            'if os.path.basename(root) == "competitions":\n            continue',
            'if (os.path.basename(root) == "competitions" or\n'
            '                os.path.exists(os.path.join(root, "train.csv")) or\n'
            '                os.path.exists(os.path.join(root, "train_series.csv"))):\n'
            '            continue')
    # The pinned Kaggle image already supplies timm; do not upgrade between runs.
    sources[0] = sources[0].split("\n", 1)[1]
    directory = f"/kaggle/working/{'ddp_smoke' if smoke else experiment + '_fold' + str(fold)}"
    header = INPUT_SEARCH + f'''\nimport hashlib, os, pathlib
EXPECTED_FOLD = {fold}
EXPECTED_SEED = {training_seed}
EXPECTED_VAL = {ALL_VALIDATION_COUNTS[fold]}
MATCH_CLASSWISE = {match_classwise!r}
MATCH_BACKBONE = {match_backbone!r}
MATCH_SLICE = {match_slice!r}
MATCH_SPATIAL = {match_spatial!r}
EXPECTED_SLICES = {24 if match_spatial else 16}
CONTROL_EXPERIMENT = {control!r}
BASELINE_CONTRACT_PATH = "/kaggle/working/{control}_fold{fold}/run_contract.json"
os.environ["KNEE_EXPERIMENT"] = {experiment!r}
os.environ["PYTHONUNBUFFERED"] = "1"
paths = attached_files("train_labels.parquet")
assert len(paths) == 1, f"Expected one label file, found {{paths}}"
assert hashlib.sha256(paths[0].read_bytes()).hexdigest() == {labels_sha256!r}, "Label file changed"
import faulthandler
faulthandler.enable()
# Keep fatal-signal diagnostics, but do not arm a background stack-dump timer.
# Fold 2 and fold 4 SIGSEGVs occurred inside scheduled dumps while training
# was progressing. Parent time limits are configured by the staging command.
'''
    if recovery:
        header += f'''
import shutil
_recovery = {recovery!r}
_checkpoints = attached_files("baseline_lit_fold1.ckpt")
assert len(_checkpoints) == 1, "Expected exactly one recoverable baseline checkpoint"
with _checkpoints[0].open("rb") as _handle:
    assert hashlib.file_digest(_handle, "sha256").hexdigest() == _recovery["checkpoint_sha256"]
shutil.copy2(_checkpoints[0], "lit_fold1.ckpt")
pathlib.Path("lit_fold1/metrics").mkdir(parents=True, exist_ok=True)
shutil.copy2(_checkpoints[0].parent / "baseline_metrics.csv", "lit_fold1/metrics/metrics.csv")
print("Recovered the completed baseline checkpoint; no baseline retraining", flush=True)
'''
    result = [header]
    guard_inserted = False
    aggregation_seed_inserted = False
    for i, source in enumerate(sources):
        if smoke and i >= 7:
            continue
        if source.startswith('FINDING, STRATIFY_BY = "Synovitis", "Effusion"'):
            continue
        if match_slice and i != 1:
            # The control must use the same successful protocol selector as
            # the slice-transformer candidate, before loaders are constructed.
            source = source.replace(
                'RUN = experiments.get_experiment(EXPERIMENT)',
                'RUN = experiments.get_experiment(EXPERIMENT)\n'
                'from dataclasses import replace\n'
                'RUN = replace(RUN, series_selection="protocol")')
        tree = ast.parse(source)
        if i != 1:  # Embedded repo source must remain byte-for-byte unchanged.
            tree = OutputPaths(directory).visit(tree)
        if match_backbone:
            for pos, node in enumerate(tree.body):
                if (isinstance(node, ast.Assign) and isinstance(node.value, ast.Call)
                        and ast.unparse(node.value.func) == "knee_lightning.KneeLitModule"):
                    keyword = next(k for k in node.value.keywords if k.arg == "backbone")
                    if ast.unparse(keyword.value) != "net.build_backbone(BACKBONE)":
                        raise ValueError("Backbone construction changed; review aggregation seeding")
                    keyword.value = ast.Name(id="_matched_backbone", ctx=ast.Load())
                    # Different trunk constructors consume different RNG draws.
                    before = ast.parse('_matched_backbone = net.build_backbone(BACKBONE)\npl.seed_everything(SEED, workers=True)').body
                    tree.body[pos:pos] = before
                    aggregation_seed_inserted = True
                    break
        for node in ast.walk(tree):
            if isinstance(node, ast.Assign) and any(
                    isinstance(t, ast.Name) and t.id == "SEED" for t in node.targets):
                node.value = ast.Constant(training_seed)
            if isinstance(node, ast.Assign) and any(
                    isinstance(t, ast.Name) and t.id == "FOLD" for t in node.targets):
                node.value = ast.Constant(fold)
            if isinstance(node, ast.Assign) and any(
                    isinstance(t, ast.Name) and t.id == "STRATEGY" for t in node.targets):
                node.value = ast.parse('"ddp" if DEVICES > 1 else "auto"', mode="eval").body
            if smoke and isinstance(node, ast.Call) and ast.unparse(node.func) == "pl.Trainer":
                node.keywords = [k for k in node.keywords if k.arg != "max_epochs"]
                node.keywords += [ast.keyword(arg=k, value=ast.Constant(v)) for k, v in {
                    "max_epochs": 1, "limit_train_batches": 8,
                    "limit_val_batches": 8, "num_sanity_val_steps": 0}.items()]
        for pos, node in enumerate(tree.body):
            if (isinstance(node, ast.Expr) and isinstance(node.value, ast.Call)
                    and ast.unparse(node.value.func) == "trainer.fit"):
                before = PREFLIGHT
                if recovery:
"""Validate the generated Colab notebook the way Jupyter actually loads it.

nbformat stores `source` as a list of strings that Jupyter concatenates with no
separator, so every line must carry its own trailing newline. A generator that
splits on "\\n" without restoring it produces a notebook that looks correct in
JSON and collapses to a single line on execution -- and validating it by
joining with "\\n" hides the bug, because that re-inserts exactly what is
missing. These tests join with "" for that reason.
"""

import ast
import json
import os
import sys

import pytest

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

NOTEBOOK = os.path.join(ROOT, "notebooks", "03_extract_labels.ipynb")
MODULE = os.path.join(ROOT, "src", "labels", "llm_extract.py")

pytestmark = pytest.mark.skipif(
    not os.path.exists(NOTEBOOK), reason="notebook not generated"
)


def load_cells():
    with open(NOTEBOOK) as handle:
        return json.load(handle)["cells"]


def cell_source(cell):
    """Concatenate exactly as Jupyter does -- no separator."""
    return "".join(cell["source"])


def code_cells():
    return [c for c in load_cells() if c["cell_type"] == "code"]


def as_python(source):
    """Strip notebook magics so the rest can be parsed as Python.

    Shell and line magics are valid in a cell but not valid Python, and they
    can appear anywhere in it -- not only on the first line, which is what an
    earlier version of this check assumed.
    """
    kept = [line for line in source.splitlines() if not is_magic(line)]
    return "\n".join(kept)


def is_magic(line):
    """A shell escape or line magic, and not a wrapped `!=` comparison.

    Dropping a continuation line that happens to start with `!=` leaves an
    unclosed parenthesis, which reads as a broken notebook cell -- the check
    then fails on source that Jupyter runs perfectly well.
    """
    stripped = line.lstrip()
    return stripped.startswith("%") or (stripped.startswith("!")
                                        and not stripped.startswith("!="))


class TestStructure:
    def test_is_valid_nbformat(self):
        with open(NOTEBOOK) as handle:
            notebook = json.load(handle)
        assert notebook["nbformat"] == 4
        assert notebook["cells"]

    def test_source_lines_keep_their_newlines(self):
        # The actual bug: without trailing newlines every cell becomes one line.
        for index, cell in enumerate(load_cells()):
            lines = cell["source"]
            for line in lines[:-1]:
                assert line.endswith("\n"), (
                    f"cell {index}: source line missing trailing newline -- "
                    f"the cell will collapse to a single line"
                )

    def test_no_multi_statement_cell_collapsed(self):
        # Belt and braces: a real code cell should span several lines.
        multiline = [c for c in code_cells() if cell_source(c).count("\n") > 3]
        assert len(multiline) >= 5


class TestCellsCompile:
    def test_every_code_cell_parses(self):
        for index, cell in enumerate(code_cells()):
            try:
                ast.parse(as_python(cell_source(cell)))
            except SyntaxError as exc:
                pytest.fail(f"code cell {index} line {exc.lineno}: {exc.text}")


class TestEmbeddedModule:
    def test_module_cell_matches_repo_source(self):
        # The notebook embeds llm_extract.py so the two cannot disagree about
        # how 13,000 generations are parsed. Regenerate after editing it.
        with open(MODULE) as handle:
            expected = handle.read().rstrip()
        embedded = [
            cell_source(c).rstrip() for c in code_cells()
            if "def parse_response" in cell_source(c)
        ]
        assert embedded, "no cell embeds the extractor module"
        assert embedded[0] == expected, (
            "notebook is stale -- rerun tools/make_notebook.py"
        )

    def test_module_cell_executes_and_exports(self):
        embedded = [
            cell_source(c) for c in code_cells()
            if "def parse_response" in cell_source(c)
        ][0]
        namespace = {}
        exec(embedded, namespace)  # noqa: S102 - validating generated output
        for name in ("SYSTEM_PROMPT", "build_prompt", "parse_response",
                     "aggregate_samples"):
            assert name in namespace, f"{name} missing from the notebook cell"

    def test_later_cells_only_use_defined_names(self):
        # Cells after the module cell call these; a rename would break the
        # notebook without breaking any test in test_llm_extract.py.
        joined = "\n".join(cell_source(c) for c in code_cells())
        for name in ("build_probability_prompt", "parse_probabilities",
                     "aggregate_probabilities", "SYSTEM_PROMPT"):
            assert joined.count(name) >= 2, f"{name} defined but never used"

    def test_the_categorical_path_is_not_silently_still_wired(self):
        # The notebook was switched to probabilities because the categorical
        # contract tied 53% of label slots onto one value. Phase C lever 3
        # (2026-08-26) reintroduced a *separate* categorical function to
        # measure the 32B, so the invariant tightens rather than disappears:
        # run_extraction -- the function that feeds llm_probs.parquet --
        # must parse probabilities only, and parse_response may appear only
        # inside run_categorical, whose output goes to its own parquet.
        joined = "\n".join(cell_source(c) for c in code_cells())
        start = joined.index("def run_extraction")
        end = joined.index("\ndef ", start + 1)
        run_extraction_body = joined[start:end]
        assert "parse_probabilities" in run_extraction_body
        assert "parse_response(" not in run_extraction_body

        start = joined.index("def run_categorical")
        end = joined.index("\ncat_gold_results", start)
        run_categorical_body = joined[start:end]
        assert "parse_response(" in run_categorical_body
        assert "parse_probabilities" not in run_categorical_body
        # And the corpus cell still calls the probability path.
        corpus = joined[joined.index("mined = run_extraction"):]
        assert "PROMPT_VARIANT" in corpus


class TestBootstrapReloads:
    """The bootstrap must not trust a module already in sys.modules.

    Writing src/*.py does nothing to an import that already happened. Re-running
    the cell in a live kernel then keeps the OLD code with the new file sitting
    unused on disk, and the run looks healthy until something calls a function
    that only exists in the new version -- after the expensive part has already
    run against stale logic.
    """

    def bootstrap(self):
        # The bootstrap lives in the Kaggle notebooks, not the Colab one --
        # only Kaggle needs the repo modules materialised.
        for name in ("01_scan_index.ipynb", "02_build_cache.ipynb"):
"""Execute the generated notebook's cells locally, stubbing only the GPU parts.

Static parsing missed a real bug once already -- every cell had collapsed to a
single line and still parsed, because the check joined the source list the same
wrong way the generator wrote it. So this runs the cells instead.

    python3 tools/check_notebook.py

Cells 2, 10 run against stubbed torch/vllm/transformers; cells 6, 8, 12, 16 run
for real against data/meta/train.csv. Cell 4 (pip install) and the real model
load cannot be verified without a GPU and are reported as such.
"""

import json
import os
import sys
import tempfile
import types

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

NOTEBOOK = os.path.join(ROOT, "notebooks", "03_extract_labels.ipynb")

GPU_TIERS = [("A100-80GB", 80), ("A100-40GB", 42), ("L4", 24), ("T4", 15)]

# The notebook extracts probabilities now, so the stub answers in that shape.
# MCL is present but low and Fracture is omitted, so the assertions can tell
# "parsed a low value" apart from "failed to parse".
STUB_RESPONSE = '{"ACL": 92, "MCL": 8}'


def load_code_cells():
    with open(NOTEBOOK) as handle:
        notebook = json.load(handle)
    return {
        index: "".join(cell["source"])
        for index, cell in enumerate(notebook["cells"])
        if cell["cell_type"] == "code"
    }


def stub_torch(total_gb, available=True):
    module = types.ModuleType("torch")
    module.cuda = types.SimpleNamespace(
        is_available=lambda: available,
        get_device_properties=lambda index: types.SimpleNamespace(
            total_memory=total_gb * 1e9
        ),
    )
    sys.modules["torch"] = module


def stub_vllm():
    vllm = types.ModuleType("vllm")

    class StubLLM:
        def __init__(self, **kwargs):
            self.kwargs = kwargs

        def generate(self, prompts, sampling):
            sample = type("Sample", (), {"text": STUB_RESPONSE})
            return [
                type("Result", (), {"outputs": [sample() for _ in range(3)]})()
                for _ in prompts
            ]

    vllm.LLM = StubLLM
    vllm.SamplingParams = lambda **kwargs: kwargs
    sys.modules["vllm"] = vllm

    transformers = types.ModuleType("transformers")
    transformers.AutoTokenizer = types.SimpleNamespace(
        from_pretrained=lambda name: types.SimpleNamespace(
            apply_chat_template=lambda messages, tokenize, add_generation_prompt:
                messages[1]["content"]
        )
    )
    sys.modules["transformers"] = transformers


def stub_colab():
    colab = types.ModuleType("google.colab")
    colab.files = types.SimpleNamespace(
        upload=lambda: {},
        download=lambda path: print(f"      [stub] download {path}"),
    )
    google = types.ModuleType("google")
    google.colab = colab
    sys.modules["google"] = google
    sys.modules["google.colab"] = colab


def check_gpu_cell(cells):
    print("cell 2 -- GPU detection and model selection")
    for name, memory in GPU_TIERS:
        stub_torch(memory)
        namespace = {}
        exec(cells[2], namespace)  # noqa: S102
        print(f"      {name:10s} -> {namespace['MODEL']}")

    stub_torch(0, available=False)
    try:
        exec(cells[2], {})  # noqa: S102
    except SystemExit as exc:
        print(f"      {'no GPU':10s} -> aborts: {exc}")
        return
    raise AssertionError("no-GPU path did not abort")


def check_logic_cells(cells):
    from src.labels import lexicon

    stub_colab()
    namespace = {"__name__": "__main__"}

    print("cell 6 -- data loading (real train.csv)")
    # Absolute, because the cells below run from a scratch directory: they
    # write the same filenames the real Colab run downloads, and a stub dump
    # left in the repo is a loaded gun. One did survive here, and its
    # lexicon-derived contents were close enough to real 32B output to be
    # scored by mistake -- the giveaway was every confidence being exactly
    # 1.0, which three identical stub samples produce and real voting cannot.
    train_csv = os.path.join(ROOT, "data", "meta", "train.csv")
    source = cells[6].replace(
        'for candidate in ["/content/drive/MyDrive/knee/train.csv", "/content/train.csv"]:',
        f'for candidate in [{train_csv!r}]:',
    )
    exec(source, namespace)  # noqa: S102

    print("cell 8 -- extractor module")
    exec(cells[8], namespace)  # noqa: S102

    # Stand in for the model by driving the notebook's own aggregation path
    # with lexicon output mapped to probabilities, so cells 12 and 16 handle
    # objects of the real shape.
    def fake_run(reports, desc="", variant="baseline", n_samples=3):
        results = []
        for report in reports:
            extracted = lexicon.extract_report(str(report))
            sample = {}
            for name, value in extracted.items():
                if value["present"] == 1:
                    sample[name] = 0.9
                elif value["present"] == 0:
                    sample[name] = 0.1
                else:
                    sample[name] = None
            results.append(namespace["aggregate_probabilities"]([sample] * 3))
        return results

    namespace["run_extraction"] = fake_run

    # The categorical twin, in the shape aggregate_samples expects.
    def fake_run_categorical(reports, desc="", n_samples=3):
        results = []
        for report in reports:
            extracted = lexicon.extract_report(str(report))
            sample = {
                name: {"present": value["present"],
                       "severity": value["severity"],
                       "evidence": value.get("span")}
                for name, value in extracted.items()
            }
            results.append(namespace["aggregate_samples"]([sample] * 3))
        return results

    namespace["run_categorical"] = fake_run_categorical
    import numpy
    namespace["np"] = numpy

    print("cell 12 -- gold sweep and AUC table")
    exec(cells[12], namespace)  # noqa: S102

    print("cell 14 -- categorical gold checkpoint")
    exec(cells[14], namespace)  # noqa: S102
    assert namespace["cat_dump"].shape[0] == 58
    assert "Medial Meniscus_severity" in namespace["cat_dump"].columns

    print("cell 18 -- frame build and save")
    namespace["mined"] = fake_run(namespace["unlabelled"]["Report"].tolist()[:50])
    namespace["unlabelled"] = namespace["unlabelled"].head(50)
    exec(cells[18], namespace)  # noqa: S102


def check_model_cell(cells):
    print("cell 10 -- model load and extraction wiring (stubbed vllm)")
    stub_vllm()
    namespace = {"MODEL": "stub"}
    exec(cells[8], namespace)  # noqa: S102
    exec(cells[10], namespace)  # noqa: S102
    results = namespace["run_extraction"](["Rotura del menisco interno."], "(stub)")
    assert results[0]["ACL"]["probability"] > 0.5
    assert results[0]["MCL"]["probability"] < 0.5
    # An omitted finding must stay None, not default to anything.
    assert results[0]["Fracture"]["probability"] is None
    # The categorical path must run the same wiring and fail parsing softly:
    # the stub answers in probability shape, which parse_response rejects,
    # and a rejected sample must come back as silence rather than raise.
    cat = namespace["run_categorical"](["Rotura del menisco interno."], "(stub)")
    assert cat[0]["ACL"]["present"] is None
    print(f"      n_samples={namespace['N_SAMPLES']} "
          f"max_model_len={namespace['llm'].kwargs.get('max_model_len')}")


def main():
    os.chdir(ROOT)
    cells = load_code_cells()

    check_gpu_cell(cells)
    check_model_cell(cells)
    # The logic cells write parquets and a zip under whatever the working
    # directory is. Run them somewhere disposable so the repo never holds a
    # file that looks like a real extraction dump.
    with tempfile.TemporaryDirectory() as scratch:
        os.chdir(scratch)
        try:
            check_logic_cells(cells)
        finally:
            os.chdir(ROOT)

    print("\nnot verifiable without a GPU:")
    print("      cell 4  -- pip install vllm")
    print("      cell 10 -- real model weights load")
    print("      cell 16 -- full corpus generation")
    print("\nall locally verifiable cells OK")


if __name__ == "__main__":
    main()
  (predictions generated **before** opening), the manifest and reference
  commitment hashes, n, the endpoints, the analysis (step 16 function and seed),
  the gate, and the noninferiority margin. Its sha256 is appended to
  `commitments.jsonl`.

**25. Open and report. [custodian]**
- *Files:* create `tools/open_locked_evaluation.py`. It refuses unless the
  registration hash is in the commitments log, the prediction hashes match, and
  the manifest hash matches. It computes the step 16 statistics, missingness,
  diagnostics by scanner group and language, and the mined-label scores as
  secondary. It writes `docs/label_quality_result.md`.
- *Gate (from the source, verbatim numbers):*
  - The macro delta must be ≥ +0.005 with its paired 95% interval above zero.
  - No priority finding may show a material regression, against a predeclared
    −0.02 noninferiority margin. An interval crossing −0.02 means "regression
    safety unresolved".
  - All twelve findings are reported.
  - A priority-finding improvement requires Holm-adjusted evidence.
- Inconclusive stays inconclusive. Any tuning after opening requires new
  confirmation data. The tool writes an `opened_at` record, and a second
  opening with a different registration is refused.

