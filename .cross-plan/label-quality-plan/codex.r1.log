"""Build a reproducible report-review queue; never alter training labels."""
import hashlib
import html
import json
from pathlib import Path
import sys

import numpy as np
import pandas as pd

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from src import config
from tools.compare_oof import read_predictions


def sha(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def build():
    out = ROOT / 'outputs/label_review_v1'
    out.mkdir(parents=True, exist_ok=True)
    summary_path = ROOT / 'data/meta/compare_protocol_incumbent_all_folds/summary.json'
    summary = json.loads(summary_path.read_text())
    folded = pd.read_parquet(ROOT / 'outputs/ensemble_16_24/reconstructed_folds.parquet')
    paths, provenance = [], []
    for entry in summary['source_receipts']:
        if entry['family'] != 'protocol':
            continue
        path = ROOT / entry['oof']
        if not path.exists():
            fold = entry['fold']
            path = ROOT / f'outputs/slice_overlay_staging/fold{fold}/baseline_fold{fold}/oof_fold{fold}.parquet'
        if sha(path) != entry['oof_sha256']:
            raise ValueError(f'Protocol OOF hash mismatch: {path}')
        sidecar = path.parent / f"convnext_fold{entry['fold']}.pt.json"
        meta = json.loads(sidecar.read_text())
        expected = set(folded.loc[folded.fold == entry['fold'], config.ID_COL])
        if set(meta['val_uids']) != expected or expected & set(meta['train_uids']):
            raise ValueError('Protocol training/validation exclusion failed')
        if meta['sha256'] != entry['checkpoint_sha256']:
            raise ValueError('Protocol checkpoint association changed')
        paths.append(path)
        provenance.append({'path': str(path.relative_to(ROOT)), 'sha256': sha(path)})
    protocol = read_predictions(paths, folded).sort_index()
    legacy_path = ROOT / 'data/meta/compare_protocol_incumbent_all_folds/incumbent_oof.parquet'
    legacy = read_predictions([legacy_path], folded).sort_index()
    if not legacy.index.equals(protocol.index):
        raise ValueError('OOF populations differ')
    labels_path = ROOT / 'data/meta/train_labels.parquet'
    reports_path = ROOT / 'data/meta/train.csv'
    labels = pd.read_parquet(labels_path).set_index(config.ID_COL)
    reports = pd.read_csv(reports_path).set_index(config.ID_COL)
    categorical = pd.read_parquet(ROOT / 'data/meta/llm_labels.parquet').set_index(config.ID_COL)
    probability = pd.read_parquet(ROOT / 'data/meta/llm_probs.parquet').set_index(config.ID_COL)
    rows = []
    # Development only. Neither held-out fold 1 nor 3 is opened for report review.
    eligible = protocol.index[protocol.fold.isin([0, 2, 4])]
    for uid in eligible:
        for finding in config.LABELS:
            target = float(labels.at[uid, finding])
            a, b = float(legacy.at[uid, finding]), float(protocol.at[uid, finding])
            direction = 'possible_missed_positive' if target < .5 else 'possible_false_positive'
            strength = min(a, b) if target < .5 else 1 - max(a, b)
            rows.append({'StudyInstanceUID': uid, 'fold': int(protocol.at[uid, 'fold']),
                'finding': finding, 'target': target,
                'weight': float(labels.at[uid, finding + '_weight']),
                'legacy_blend': a, 'protocol': b, 'direction': direction,
                'opposition_strength': strength,
                'categorical_call': None if pd.isna(categorical.at[uid, finding]) else float(categorical.at[uid, finding]),
                'categorical_evidence': str(categorical.at[uid, finding + '_evidence']),
                'probability_target': float(probability.at[uid, finding]),
                'report': str(reports.at[uid, 'Report'])})
    pairs = pd.DataFrame(rows)
    # Threshold fixed before reviewing text; require BOTH available sources to oppose.
    candidates = pairs[pairs.opposition_strength >= .7].copy()
    if len(candidates) < 200:
        raise ValueError(f'Only {len(candidates)} strong disagreements; do not silently loosen threshold')
    selected = candidates.sort_values('opposition_strength', ascending=False, kind='stable').head(200).copy()
    selected['sample'] = 'disagreement'
    # Random control comes from the remaining pair population, not just agreements.
    controls = pairs.drop(index=selected.index).sample(n=50, random_state=20260915).copy()
    controls['sample'] = 'random_control'
    packet = pd.concat([selected, controls], ignore_index=True)
    packet.insert(0, 'review_id', [f'R{i:03}' for i in range(1, len(packet)+1)])
    notes_path = ROOT / 'tools/label_review_v1_notes.json'
    notes = json.loads(notes_path.read_text()) if notes_path.exists() else {}
    packet['review_status'] = [notes.get(i, ['evidence_screened_full_report_pending', ''])[0] for i in packet.review_id]
    packet['review_note'] = [notes.get(i, ['', ''])[1] for i in packet.review_id]
    packet['review_scope'] = ['full_report' if i in notes else 'categorical_evidence_only' for i in packet.review_id]
    packet.to_json(out / 'review_queue.jsonl', orient='records', lines=True, force_ascii=False)
    stats = {'population_studies': len(eligible), 'population_pairs': len(pairs),
        'strong_disagreements': len(candidates), 'review_pairs': len(packet),
        'discovery_folds': [0, 2, 4], 'reserved_folds': [1, 3],
        'selected_by_finding': selected.finding.value_counts().to_dict(),
        'selected_by_direction': selected.direction.value_counts().to_dict(),
        'selected_by_weight': selected.weight.value_counts().to_dict(),
        'review_status_counts': packet.review_status.value_counts().to_dict(),
        'protocol_provenance': provenance,
        'input_sha256': {str(p.relative_to(ROOT)): sha(p) for p in [labels_path, reports_path, legacy_path, summary_path]},
        'limitation': 'Legacy blend has recorded OOF provenance but missing individual source files; independent legacy training exclusion cannot be re-proven. Protocol exclusion checked against sidecars. Correlated predictions are review signals, not ground truth. Discovery folds are not clean future validation folds.'}
    (out / 'summary.json').write_text(json.dumps(stats, indent=2) + '\n')
    cards = []
    for row in packet.to_dict('records'):
        cards.append('<article><h2>' + html.escape(f"{row['review_id']} — {row['finding']} ({row['sample']})") + '</h2><p>'
            + html.escape(f"Fold {row['fold']} | target {row['target']:.3f} | weight {row['weight']:.3f} | legacy {row['legacy_blend']:.3f} | protocol {row['protocol']:.3f}")
            + '</p><p>Review: ' + html.escape(row['review_status'] + ' — ' + row['review_note'])
            + '</p><p>Extractor evidence: ' + html.escape(row['categorical_evidence']) + '</p><pre>' + html.escape(row['report']) + '</pre></article>')
    (out / 'review.html').write_text('<!doctype html><meta charset="utf-8"><title>Label review</title><style>body{max-width:950px;margin:30px auto;font:16px sans-serif}pre{white-space:pre-wrap}article{border-top:1px solid #aaa;padding:20px 0}</style><h1>Label review — development folds 0, 2, 4</h1><p>Review suggestions only. No labels changed. Report agreement does not establish image truth.</p>' + ''.join(cards))
    print(json.dumps({k:v for k,v in stats.items() if k not in ['protocol_provenance','input_sha256']}, indent=2))


if __name__ == '__main__':
    build()
"""Turn a raw DICOM series into a compact, model-ready uint8 volume.

The same code path runs during cache construction and at submission time. Any
divergence between the two produces a train/test preprocessing skew, which is
invisible in local validation and only shows up as a collapsed leaderboard
score -- so callers must import from here rather than reimplementing.

Output per series: (CACHE_SLICES, CACHE_SIZE, CACHE_SIZE) uint8, in the
orientation it was acquired in. Mirroring to a canonical side happens at load
time rather than here -- see config.MIRROR_IN_CACHE for why.
"""

from typing import Dict, List, Optional, Sequence

import cv2
import numpy as np

from src import config
from src.data import dicom_io


def normalize_intensity(volume: np.ndarray) -> np.ndarray:
    """Scale a volume to uint8 using its own robust percentile range.

    MRI carries no standardised units -- intensity depends on scanner, field
    strength, coil, and whether fat suppression was applied -- so each volume is
    scaled against its own distribution rather than a global constant.
    """
    finite = volume[np.isfinite(volume)]
    if finite.size == 0:
        return np.zeros(volume.shape, dtype=np.uint8)

    low, high = np.percentile(finite, [config.CLIP_PCT_LOW, config.CLIP_PCT_HIGH])
    if not np.isfinite(low) or not np.isfinite(high) or high <= low:
        # Flat or degenerate volume; nothing to stretch.
        return np.zeros(volume.shape, dtype=np.uint8)

    scaled = (np.clip(volume, low, high) - low) / (high - low)
    return (scaled * 255.0).round().astype(np.uint8)


def resize_volume(volume: np.ndarray, size: int = None) -> np.ndarray:
    """Resample every slice to size x size with area/linear interpolation."""
    size = size or config.CACHE_SIZE
    output = np.empty((volume.shape[0], size, size), dtype=volume.dtype)

    for i, plane in enumerate(volume):
        # Area interpolation avoids the aliasing that bilinear introduces when
        # downsampling 800px acquisitions; linear is correct when upsampling.
        interp = cv2.INTER_AREA if plane.shape[0] > size else cv2.INTER_LINEAR
        output[i] = cv2.resize(plane, (size, size), interpolation=interp)

    return output


def select_slices(count: int, target: int = None) -> List[int]:
    """Indices of `target` slices spread evenly across a stack of `count`.

    Short series are handled by repeating edge slices rather than zero-padding,
    so the volume stays anatomically continuous.
    """
    target = target or config.CACHE_SLICES
    if count <= 0:
        raise ValueError("cannot select slices from an empty series")
    if count == target:
        return list(range(count))

    positions = np.linspace(0, count - 1, target)
    return [int(round(p)) for p in positions]


def mirror_axis(orientation: Optional[Sequence[float]]) -> int:
    """Which array axis runs medial-to-lateral, from the scanner geometry.

    Mirroring a knee means reflecting through the patient's left-right axis,
    and which array axis that corresponds to depends on the acquisition plane:

        coronal / axial   left-right lies in-plane  -> flip columns (axis 2)
        sagittal          left-right is the slice axis -> reverse slices (axis 0)

    A blanket column flip is wrong for sagittal series. It leaves medial and
    lateral exactly where they were -- they are separated across slices, not
    across the image -- and instead reflects anterior-posterior, moving the
    patella to the back of the knee.

    Returns 0, 1, or 2: the axis of a (slices, rows, cols) volume to reverse.
    """
    left_right = np.array([1.0, 0.0, 0.0])

    if orientation is None or len(orientation) != 6:
        # No geometry to reason from. Columns is the common case (coronal and
        # axial together outnumber sagittal), but the caller should prefer not
        # to mirror at all when geometry is missing.
        return 2

    width = np.asarray(orientation[:3], dtype=float)    # increasing column index
    height = np.asarray(orientation[3:], dtype=float)   # increasing row index
    normal = dicom_io.slice_normal(orientation)

    alignments = [
        (abs(float(normal @ left_right)), 0),
        (abs(float(height @ left_right)), 1),
        (abs(float(width @ left_right)), 2),
    ]
    return max(alignments)[1]


def canonicalize_side(volume: np.ndarray, side: Optional[str],
                      orientation: Optional[Sequence[float]] = None) -> np.ndarray:
    """Mirror left knees so the medial compartment is always on one side.

    Four labels are compartment-specific (Medial/Lateral Meniscus, Medial/
    Lateral OA). Without this the model would have to infer the side before it
    could place a finding, from a cue that is not reliably in the image.

    The axis reflected is chosen from the acquisition geometry -- see
    mirror_axis -- because it differs between sagittal and coronal series.
    """
    if side is None:
        # Unknown side: leave untouched and let the caller decide. Guessing
        # would silently swap four of the twelve labels.
        return volume
    if side.upper() == config.CANONICAL_SIDE:
        return volume

    axis = mirror_axis(orientation)
    return np.flip(volume, axis=axis).copy()


def submission_indices(count: int, slices: int) -> List[int]:
    """Raw slice indices a `slices`-deep submission actually reads.

    **Not** `select_slices(count, slices)`, and the difference is the whole
    reason this exists. The submission decodes `CACHE_SLICES` and then
    subsamples with `np.linspace(0, CACHE_SLICES - 1, TUNED_SLICES)`; picking
    `slices` evenly across the raw stack in one step lands on *different
    files* for 41 of the 44 series lengths between 16 and 60. The model would
    then be scored on anatomy it was not trained to read, and nothing would
    raise -- the shapes agree either way. That is the same failure the
    `volumes[:MAX_SERIES]` head truncation already cost this project.

    So the two selections are composed rather than collapsed: the coarse pick
    the cache would have made, then the fine pick the model applies to it.
    """
    coarse = select_slices(count)
    if slices == config.CACHE_SLICES:
        return coarse
    return [coarse[i] for i in select_slices(config.CACHE_SLICES, slices)]


def build_series_volume(headers: Sequence[dict],
