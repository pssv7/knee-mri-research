    print(f"  gold from the selected epoch on: range "
          f"{_tail.max() - _tail.min():.3f} over {len(_tail)} epochs")
    if _val.iloc[-1] < _val.max() - 0.005 and _tail.max() - _tail.min() < 0.02:
