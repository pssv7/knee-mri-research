class StudyIndex:
    """Everything needed to assemble a study, resolved once up front.

    Built from frames rather than files so it can be constructed in a test
    without touching disk.
    """

    def __init__(self, manifest: pd.DataFrame, series_meta: pd.DataFrame,
                 labels: Optional[pd.DataFrame] = None,
                 sides: Optional[pd.DataFrame] = None,
                 max_series: Optional[int] = None,
                 reports: Optional[pd.DataFrame] = None,
                 series_selection: str = "uniform"):
        frame = manifest.merge(
            series_meta[["SeriesInstanceUID", "Fluid_Sensitive",
                         "Fat_Suppression", "Anatomical_Plane"]],
            on="SeriesInstanceUID", how="left", validate="one_to_one")

        if sides is not None:
            frame = frame.merge(
                sides[["SeriesInstanceUID", "side_predicted"]],
                on="SeriesInstanceUID", how="left", validate="one_to_one")
        else:
            frame["side_predicted"] = frame.get("laterality_resolved")

        # Drop series whose volume failed to build; their row in the cache is
        # zeros and would train the model on blank images.
        if "error" in frame.columns:
            frame = frame[frame["error"].isna()].reset_index(drop=True)

        if series_selection == "protocol":
            frame = frame.sort_values("SeriesInstanceUID", kind="stable").reset_index(drop=True)
        self.series = frame
        self.max_series = max_series
        self.series_selection = series_selection
        select_series(frame.iloc[:0], max_series, series_selection)
        self.labels = labels

        self.studies: List[str] = sorted(frame[config.ID_COL].unique())
        self._by_study = {
            study: group.reset_index(drop=True)
            for study, group in frame.groupby(config.ID_COL)
        }

        if labels is not None:
            if labels[config.ID_COL].duplicated().any():
                raise ValueError("duplicate study IDs in labels")
            keyed = labels.set_index(config.ID_COL)
            self.studies = [s for s in self.studies if s in keyed.index]
            self._labels = keyed
        else:
            self._labels = None

        # Report sentence embeddings, a training-time-only signal: reports
        # exist for train studies and never for test, so these feed an
        # auxiliary loss rather than the model input. Stored as one float32
        # matrix rather than a DataFrame so __getitem__ is an array row.
        if reports is not None:
            keyed_reports = reports.set_index(config.ID_COL)
            self._report_rows = {study: i for i, study
                                 in enumerate(keyed_reports.index)}
            self._report_matrix = keyed_reports.to_numpy(dtype=np.float32)
            self.report_dim = self._report_matrix.shape[1]
        else:
            self._report_rows = None
            self._report_matrix = None
            self.report_dim = None

    def __len__(self) -> int:
        return len(self.studies)
def aucs(truth, probs):
    return np.array([_auc(truth[:, i], probs[:, i]) for i in range(truth.shape[1])])


def compare(labels, baseline, candidate, draws=1000, seed=0):
    shared = baseline.index.intersection(candidate.index).sort_values()
    if not len(shared):
        raise ValueError("no shared OOF studies")
    truth = (labels.set_index(config.ID_COL).loc[shared, config.LABELS].to_numpy() >= .5).astype(int)
    a, b = [frame.loc[shared, config.LABELS].to_numpy(float) for frame in (baseline, candidate)]
    predictions = {"baseline": a, "candidate": b, "blend_50_50": (a + b) / 2}
    results = {name: aucs(truth, pred) for name, pred in predictions.items()}
    table = pd.DataFrame(results, index=config.LABELS)
    table["candidate_delta"] = table.candidate - table.baseline
    table["blend_delta"] = table.blend_50_50 - table.baseline
    rng = np.random.default_rng(seed)
    fold = baseline.loc[shared, "fold"].to_numpy()
    blocks = [np.flatnonzero(fold == f) for f in np.unique(fold)]
    per_fold = {str(int(f)): {name: float(np.nanmean(aucs(truth[fold == f], pred[fold == f])))
                             for name, pred in predictions.items()} for f in np.unique(fold)}
    deltas = {"candidate": [], "blend_50_50": []}
    for _ in range(draws):
        chosen = np.concatenate([rng.choice(block, len(block), replace=True) for block in blocks])
        base = aucs(truth[chosen], a[chosen])
        for name in deltas:
            values = aucs(truth[chosen], predictions[name][chosen])
            valid = np.isfinite(base) & np.isfinite(values)
            if valid.any():
                deltas[name].append(float((values[valid] - base[valid]).mean()))
    summary = {"shared_studies": len(shared), "folds": sorted(set(map(int, fold))),
               "baseline_only": len(baseline.index.difference(shared)),
               "candidate_only": len(candidate.index.difference(shared)),
               "macro": {k: float(np.nanmean(v)) for k, v in results.items()},
               "per_fold_macro": per_fold,
               "paired_macro_delta_95ci": {
                   k: np.quantile(v, [.025, .975]).tolist() for k, v in deltas.items()},
               "limitation": "Mined-label OOF proxy; fold provenance asserted by files, not proof of training exclusion. Bootstrap holds fitted models fixed; it excludes retraining variability."}
    return table, summary


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--labels", default=None,
                        help="shipped train_labels.parquet; defaults to META_DIR")
    parser.add_argument("--sweep", action="store_true",
                        help="also sweep LEXICON_WEIGHT against gold")
    parser.add_argument("--out", default=None,
                        help="write the per-language table to this csv")
    args = parser.parse_args()

    shipped_path = Path(args.labels or (config.META_DIR / "train_labels.parquet"))
    shipped = pd.read_parquet(shipped_path)
    print(f"shipped  {shipped_path}  {shipped.shape}\n")

    rebuilt, fused_gold, _ = fuse.build()
    ok = check_reproduction(shipped, rebuilt)
    ok &= check_properties(shipped)
    check_against_gold(calibrate.load_gold(config.TRAIN_CSV), fused_gold)

    reports = pd.read_csv(config.TRAIN_CSV)
    reports["language"] = reports["Report"].map(detect_language)
    unlabelled = calibrate.load_unlabelled(config.TRAIN_CSV)
    table = language_reach(reports, unlabelled)
    stem_reach(reports)

    if args.sweep:
        sweep_lexicon_weight(calibrate.load_gold(config.TRAIN_CSV))
    if args.out:
        table.to_csv(args.out, index=False)
        print(f"\nwrote {args.out}")

    print("\n" + ("ALL CHECKS PASSED" if ok else "CHECKS FAILED"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
"""Execute the generated notebook's cells locally, stubbing only the GPU parts.

Static parsing missed a real bug once already -- every cell had collapsed to a
single line and still parsed, because the check joined the source list the same
wrong way the generator wrote it. So this runs the cells instead.

    python3 tools/check_notebook.py

Cells 2, 10 run against stubbed torch/vllm/transformers; cells 6, 8, 12, 16 run
for real against data/meta/train.csv. Cell 4 (pip install) and the real model
load cannot be verified without a GPU and are reported as such.
"""

import json
import os
import sys
import tempfile
import types

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

NOTEBOOK = os.path.join(ROOT, "notebooks", "03_extract_labels.ipynb")

GPU_TIERS = [("A100-80GB", 80), ("A100-40GB", 42), ("L4", 24), ("T4", 15)]

# The notebook extracts probabilities now, so the stub answers in that shape.
# MCL is present but low and Fracture is omitted, so the assertions can tell
# "parsed a low value" apart from "failed to parse".
STUB_RESPONSE = '{"ACL": 92, "MCL": 8}'


def load_code_cells():
    with open(NOTEBOOK) as handle:
        notebook = json.load(handle)
    return {
        index: "".join(cell["source"])
        for index, cell in enumerate(notebook["cells"])
        if cell["cell_type"] == "code"
    }


def stub_torch(total_gb, available=True):
    module = types.ModuleType("torch")
    module.cuda = types.SimpleNamespace(
        is_available=lambda: available,
        get_device_properties=lambda index: types.SimpleNamespace(
            total_memory=total_gb * 1e9
        ),
    )
    sys.modules["torch"] = module


def stub_vllm():
    vllm = types.ModuleType("vllm")

    class StubLLM:
        def __init__(self, **kwargs):
            self.kwargs = kwargs

        def generate(self, prompts, sampling):
            sample = type("Sample", (), {"text": STUB_RESPONSE})
            return [
                type("Result", (), {"outputs": [sample() for _ in range(3)]})()
                for _ in prompts
            ]

    vllm.LLM = StubLLM
    vllm.SamplingParams = lambda **kwargs: kwargs
    sys.modules["vllm"] = vllm

    transformers = types.ModuleType("transformers")
    transformers.AutoTokenizer = types.SimpleNamespace(
        from_pretrained=lambda name: types.SimpleNamespace(
            apply_chat_template=lambda messages, tokenize, add_generation_prompt:
                messages[1]["content"]
        )
    )
    sys.modules["transformers"] = transformers


def stub_colab():
    colab = types.ModuleType("google.colab")
    colab.files = types.SimpleNamespace(
        upload=lambda: {},
        download=lambda path: print(f"      [stub] download {path}"),
    )
    google = types.ModuleType("google")
    google.colab = colab
    sys.modules["google"] = google
    sys.modules["google.colab"] = colab


